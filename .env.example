DATABASE_URL=mysql://appointmentproject:appointmentproject@127.0.0.1:3308/appointmentproject

MYSQL_PORT=3308
MYSQL_DATABASE=appointmentproject
MYSQL_USER=appointmentproject
MYSQL_PASSWORD=appointmentproject
MYSQL_ROOT_PASSWORD=change-me-root-dev

# NextAuth — run: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/)
# Admin users must sign in with one of these emails via Google.
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret
ADMIN_EMAILS=owner@yourdomain.com

# Redis (required for distributed API rate limiting)
# Falls back to in-process memory limiter when not set (dev only).
REDIS_URL=redis://127.0.0.1:6379

# Auth rate limiting (optional — defaults shown)
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Legacy owner-token auth (deprecated)
# Always disabled in production regardless of this flag.
# Set to true only for temporary local migration/testing.
ALLOW_LEGACY_OWNER_TOKEN_AUTH=false
OWNER_DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Booking page service and barber fallbacks (public, comma-separated)
# Used only if the database has no active staff yet.
NEXT_PUBLIC_SERVICES=Classic cut,Fade + beard,VIP grooming
NEXT_PUBLIC_BARBERS=Luis,Marcos,Andrea

# Dev email: magic links are always printed to the server console.
# Set TEST_EMAIL to document which inbox you are testing with.
TEST_EMAIL=your-email@example.com
